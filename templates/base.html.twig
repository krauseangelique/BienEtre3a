<!DOCTYPE html>
<html>
	<head>
		<meta
		charset="UTF-8">
		{# Tous supports : Mobile, Tablette, Ordi,...Le viewport du navigateur est la zone de la fenêtre dans laquelle le contenu web peut être vu. in https://developer.mozilla.org/fr/docs/Web/HTML/Viewport_meta_tag #}


		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>
			{% block title %}Bienvenu sur notre site Bien-être | lartdebienetre.be

			{% endblock %}
			- Annuaire Bien-Etre

		</title>
		{# !! L'icôn et son lien sont à MODIFIER #}
		{# <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>"> #}
		<link
		rel="shortcut icon" href="/public/images/logoSite/cropped-LArt-de-Bien-Etre.png" type="image/x-icon">


		{# lIEN BOOTSTRAP #}
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">


		{% block stylesheets %}
			{{ ux_controller_link_tags() }}
		{% endblock %}

		{% block javascripts %}
			{% block importmap %}
				{{ importmap('app') }}
			{% endblock %}
		{% endblock %}
	</head>
	<body>

		{% block body %}BODY
		{% endblock %}

		{% block header %}
			<header
				class="container-fluid element-color header ">
				{# <strong>header</strong> #}

				<div class="logo d-flex justify-content-around   ">

					<div
						class="logo-content flex-item-left ">

						{# le front Controller index.php est DEJA dans public donc le chemin pour images est images/nomdelimage #}
						<a href="{{path('app_home')}}">
							<h1>
								<span>Annuaire Bien Etre</span>
								<img src="images/logoSite/cropped-LArt-de-Bien-Etre.png" class="small" alt="logo du site" title="Annuaire Bien Etre">
							</h1>
						</a>
					</div>

					{% block nav %}

						<nav class="navigation flex-item-right ">

							<ul class="identification ">
								<li class="iconApropos m-1 p-1">
									<a href="{{path('app_propos')}}">Inscription<img src=" {{asset('images/icones/inscription.png')}}" alt="lien vers la page Home"></a>

								</li>
								<li class="iconContact  p-1">
									<a href="{{path('app_contact')}}">Mon&nbsp;Compte<img src=" {{asset('images/icones/identification_card.png')}}" alt="lien vers la page Home"></a>
								</li>
							</ul>

							<ul class="menu ">
								<li class="iconHome  p-1">
									<a href="{{path('app_home')}}">Home
										<img src=" {{asset('images/icones/menu_liste.png')}}" alt="lien vers la page Home"></a>
								</li>
								<li class="iconApropos  p-1">
									<a href="{{path('app_propos')}}">A&nbsp;propos<img src=" {{asset('images/icones/menu_liste.png')}}" alt="lien vers la page Home"></a>

								</li>
								<li class="iconContact  p-1">
									<a href="{{path('app_contact')}}">Contact<img src=" {{asset('images/icones/menu_liste.png')}}" alt="lien vers la page Home"></a>

								</li>
							</ul>
						</nav>
					{% endblock %}

				</div>
			</header>

		{% endblock %}

		{% block slider %}
			<div class="container-fluid element-color slider ">

				<img src=" {{asset('images/slider/teapot.jpg')}} " alt="teapot">
				<img src=" {{asset('images/slider/black-swallowtail.jpg')}} " alt="teapot">
				<img src=" {{asset('images/slider/equilibre-pixabay.jpg')}} " alt="teapot">
				<img src=" {{asset('images/slider/stock-petales-roses.jpg')}} " alt="teapot">
				<img src=" {{asset('images/slider/cannelle-devostock.webp')}} " alt="teapot">

			</div>
		{% endblock %}

		{% block content %}{% endblock %}

		{% block footer %}

			<footer class="container-fluid p-flex element-color footer">
				<p>
					<a href="{{path('app_home')}}">Annuaire Bien-Être</a>
				</p>

				<nav>
					<ul>
						<li class="pe-2">
							<a href="#">Newsletter</a>
						</li>
						<li>
							<a href="{{path('app_home')}}">Home</a>
						</li>
						<li>
							<a href="{{path('app_propos')}}">A&nbsp;propos</a>
						</li>
						<li>
							<a href="{{path('app_contact')}}">Contact</a>
						</li>
					</ul>
				</nav>


			</footer>

		{% endblock %}


		<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js" integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy" crossorigin="anonymous"></script>
	</body>
</html>
